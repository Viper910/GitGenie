{
  "name": "gitgenie",
  "version": "1.0.0",
  "description": "Production-Grade AI-Powered Git Terminal Assistant",
  "type": "module",
  "bin": {
    "gitgenie": "./dist/bin/gitgenie.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx bin/gitgenie.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "git",
    "ai",
    "terminal",
    "cli",
    "assistant",
    "openrouter",
    "automation",
    "developer-tools"
  ],
  "author": "GitGenie Team",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.7.0",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "dotenv": "^16.4.7",
    "ffmpeg-static": "^5.3.0",
    "ora": "^8.2.0",
    "prompts": "^2.4.2",
    "sherpa-onnx": "^1.13.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
